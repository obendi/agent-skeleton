# Copy this file to .env and adjust DOMAIN if your domain changes
#   cp .env.example .env

# Main domain (used for Host(`...`) in Traefik)
DOMAIN=domain.net

# Use the SAME host directory in nginx and Hermes.
# Relative to this Compose directory; defaults to data/site in the repository.
# An absolute host path is also supported.
SITE_ROOT=../../data/site
