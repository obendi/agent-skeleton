DOMAIN=example.com
# Consumer credentials only; never use the PostgreSQL infrastructure administrator.
# Match WEBAPP_OWNER_PASSWORD and WEBAPP_APP_PASSWORD in postgres/.env.
DATABASE_MIGRATION_PASSWORD=
DATABASE_APP_PASSWORD=

# IBKR: apply ibkr.override.yml to use the containerized Gateway.
IBKR_ACCOUNT_ID=
IBKR_OWNER_USER_ID=
