# Copy this file to .env and fill in the real values
#   cp .env.example .env
#
# This file holds ONLY values used for Compose interpolation (Traefik labels and bind mounts).
# Nothing here is injected into the container. Application secrets such as API
# keys go in app.env (see app.env.example).

# Main domain (used for Host(`hermes.${DOMAIN}`) in Traefik)
DOMAIN=domain.net

# Use the SAME host directory in nginx and Hermes.
# Relative to this Compose directory; defaults to data/site in the repository.
# An absolute host path is also supported.
SITE_ROOT=../../data/site

# Private state, outside SITE_ROOT. Only Hermes and the host administrator need access.
# Relative to this Compose directory. Create explicitly with restricted permissions.
HERMES_DATA_ROOT=../../data/hermes
