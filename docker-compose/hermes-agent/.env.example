# Copy this file to .env and fill in the real values
#   cp .env.example .env
#
# This file holds ONLY values used for Compose interpolation (Traefik labels).
# Nothing here is injected into the container. Application secrets such as API
# keys go in app.env (see app.env.example).

# Main domain (used for Host(`hermes.${DOMAIN}`) in Traefik)
DOMAIN=domain.net

# --- Basic Auth (Traefik) ---
# Users for the basicauth middleware (format: user:bcrypt_hash).
# Generate the hash with: htpasswd -nbB <user> <password> | cut -d: -f2
# Use -B (bcrypt); the default MD5 crypt is not acceptable for a public endpoint.
# IMPORTANT: escape each $ in the hash as $$, otherwise docker-compose interprets it as a variable.
# HERMES_BASIC_AUTH_USERS=user:$$2y$$05$$OTU4NT...
