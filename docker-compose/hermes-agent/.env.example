# Copy this file to .env and fill in the real values
#   cp .env.example .env

# --- API keys (fill in according to what hermes-agent uses) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# HERMES_API_KEY=

# --- Hermes configuration ---
# HERMES_LOG_LEVEL=info
# HERMES_DATA_DIR=/opt/data

# Main domain (used for Host(`hermes.${DOMAIN}`) in Traefik)
DOMAIN=domain.net

# --- Basic Auth (Traefik) ---
# Users for the basicauth middleware (format: user:bcrypt_hash).
# Generate the hash with: htpasswd -nb <user> <password> | cut -d: -f2
# IMPORTANT: escape each $ in the hash as $$, otherwise docker-compose interprets it as a variable.
# HERMES_BASIC_AUTH_USERS=user:$$2y$$05$$OTU4NT...
