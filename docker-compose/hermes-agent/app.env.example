# Copy this file to app.env and fill in the real values
#   cp app.env.example app.env
#
# These variables ARE injected into the hermes container (env_file). Keep DOMAIN
# out of here: it belongs in .env.
#
# Compose can interpolate unquoted/double-quoted values. Use single quotes
# for literal values containing $, rather than assuming raw passthrough.

# --- Model provider (OpenCode Go) ---
OPENCODE_GO_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# --- Dashboard authentication ---
# The dashboard binds to 0.0.0.0 and is exposed via Traefik, so it MUST be
# protected. Generate the secret with: openssl rand -base64 32
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# --- Hermes configuration ---
HERMES_DATA_DIR=/opt/data
